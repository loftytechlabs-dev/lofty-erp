# Lofty ERP Environment Configuration
# Copy this file to .env.local and configure with your Firebase project credentials.

VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=1:your-app-id:web:your-app-code

# Set to "true" to connect to local Firebase Emulators (Auth on 9099, Firestore on 8080, Functions on 5001)
VITE_FIREBASE_USE_EMULATOR=false

# If Firebase keys are not provided or VITE_USE_DEMO_MODE=true, Lofty ERP operates in seamless
# local sandbox mode so all features, workflows, and tests can be explored immediately.
VITE_USE_DEMO_MODE=false
